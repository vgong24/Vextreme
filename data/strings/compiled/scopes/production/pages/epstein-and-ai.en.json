  "pages.epstein-and-ai.body.div008.span001.text001": {
    "text": "Phase IV"
  },
  "pages.epstein-and-ai.body.div008.h2001.text001": {
    "text": "The Witnesses Stand"
  },
  "pages.epstein-and-ai.body.p007.text001": {
    "text": "The body confirms what the mind already knew. Then the AI that ran the investigation cross-examines its own doubt — and refuses to retreat. Two witnesses. One standing."
  },
