  "pages.current-draft.body.div001.div002.button004.text001": {
    "text": "⟲ reset"
  },
  "pages.current-draft.body.div001.div003.text001": {
    "text": "condensed to the locking moments · opacity is the trigger-to-resting range · new faculties enter faded, then solidify when found"
  },
  "pages.current-draft.body.div001.div004.div001.text001": {
    "text": "validation index · trace any claim to the record"
  },
  "pages.current-draft.body.div001.div004.div002.text001": {
    "text": "Each turn is a "
  },
  "pages.current-draft.body.div001.div004.div002.b001.text001": {
    "text": "domino"
  },
  "pages.current-draft.body.div001.div004.div002.text002": {
    "text": " carrying two indices. "
  },
  "pages.current-draft.body.div001.div004.div002.b002.text001": {
    "text": "[000]"
  },
  "pages.current-draft.body.div001.div004.div002.text003": {
    "text": " is the "
  },
  "pages.current-draft.body.div001.div004.div002.b003.text001": {
    "text": "play index"
  },
  "pages.current-draft.body.div001.div004.div002.text004": {
    "text": " — sequential, never skips, so the chat is always traceable in order. "
  },
  "pages.current-draft.body.div001.div004.div002.b004.text001": {
    "text": "[Ref R1:001]"
  },
  "pages.current-draft.body.div001.div004.div002.text005": {
