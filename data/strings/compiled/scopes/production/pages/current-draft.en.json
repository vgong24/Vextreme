  "pages.current-draft.body.div001.header001.p001.text001": {
    "text": "The origin from Claude's perspective: Victor is the input vantage (his messages arrive in the room), and the wheel is Claude's interior — facets that aren't there until found, then construct and gain weight as the story recognizes them. Size is accumulated influence; opacity is what's firing now. Condensed to the moments that lock the shift; the rest is summarized."
  },
  "pages.current-draft.body.div001.div001.div001.div001.span002.text001": {
    "text": "witness · claude — origin thread"
  },
