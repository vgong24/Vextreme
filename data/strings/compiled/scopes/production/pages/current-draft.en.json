  "pages.current-draft.body.div001.div004.div002.b005.text001": {
    "text": "transcript reference"
  },
  "pages.current-draft.body.div001.div004.div002.text006": {
    "text": " — round + Claude's real index in the Witness Record. When the Ref "
  },
  "pages.current-draft.body.div001.div004.div002.i001.text001": {
    "text": "jumps"
  },
  "pages.current-draft.body.div001.div004.div002.text007": {
