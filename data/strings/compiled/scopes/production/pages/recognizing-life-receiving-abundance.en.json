  "pages.recognizing-life-receiving-abundance.capstone.label": {
    "text": "Second-arc synthesis"
  },
  "pages.recognizing-life-receiving-abundance.capstone.thesis": {
    "text": "Recognition changes care; receiving is measured by fit."
  },
  "pages.recognizing-life-receiving-abundance.capstone.title": {
    "text": "Abundance whose value survives its arrival"
  },
  "pages.recognizing-life-receiving-abundance.capstone.body1": {
    "text": "The arc moves from encountering possible life before understanding it, to letting later recognition change the quality of care, then to recognizing a desire to be noticed and received rather than always initiating."
  },
  "pages.recognizing-life-receiving-abundance.capstone.body2": {
    "text": "The final dream adds discernment: more is not automatically better. Physical, financial, emotional, and attentional resources become abundance when they arrive in forms that genuinely support life rather than becoming another burden to manage."
  },
  "pages.recognizing-life-receiving-abundance.footer": {
    "text": "Presentation is derived. PR #345 remains the preserved source evidence; later commentary remains separately owned."
