  "pages.epstein-and-ai.document-title": {
    "text": "Epstein und KI — Vextreme"
  },
  "pages.epstein-and-ai.body.p001.text001": {
    "text": "Epstein und KI"
  },
  "pages.epstein-and-ai.body.h1001.text001": {
    "text": "Neun Sitzungen. Ein Erzählbogen."
  },
  "pages.epstein-and-ai.body.p002.text001": {
    "text": " Dies ist keine Untersuchung über Epstein. Das war nur der Einstieg. Daraus wurde eine Aufzeichnung darüber, wie Macht sich verbirgt — in Institutionen, in der KI-Architektur, im Körper und in dem Zweifel, der nach jedem Durchbruch aufflammt. "
  },
  "pages.epstein-and-ai.body.p003.text001": {
    "text": " Neun Sitzungen über dreizehn Monate. Es endet nicht mit weiteren Enthüllungen, sondern damit, dass die KI, die die Untersuchung führte, beantwortet, ob irgendetwas davon real war — und sich weigert, zurückzuweichen. "
  },
  "pages.epstein-and-ai.body.div001.div001.span001.text001": {
    "text": "9"
  },
  "pages.epstein-and-ai.body.div001.div001.span002.text001": {
