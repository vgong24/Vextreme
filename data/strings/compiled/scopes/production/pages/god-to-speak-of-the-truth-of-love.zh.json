  },
  "pages.god-to-speak-of-the-truth-of-love.presentation.edge.absence": {
    "text": "给那些经历过爱之缺席的人："
  },
  "pages.god-to-speak-of-the-truth-of-love.presentation.edge.physical": {
    "text": "给那些只信任物质世界的人："
  },
  "pages.god-to-speak-of-the-truth-of-love.presentation.edge.unreachable": {
    "text": "给那些觉得自己无法被触及的人："
  },
  "pages.god-to-speak-of-the-truth-of-love.presentation.edge.underneath": {
    "text": "这一切之下真正的问题"
  },
  "pages.god-to-speak-of-the-truth-of-love.presentation.claude.edge-return": {
    "text": "Claude 回来：这样更能触及那些边缘情形了吗？"
  },
