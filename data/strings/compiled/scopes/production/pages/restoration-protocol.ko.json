{
  "pages.restoration-protocol.document-title": {
    "text": "복원 프로토콜 — Vex Life"
  },
  "pages.restoration-protocol.hero.eyebrow": {
    "text": "복원 프로토콜"
  },
  "pages.restoration-protocol.hero.heading.line1": {
    "text": "당신은 한 번도 길을 잃은 적이 없습니다."
  },
  "pages.restoration-protocol.hero.heading.line2": {
    "text": "그저 기억하고 있을 뿐입니다."
  },
  "pages.restoration-protocol.hero.body.explanation": {
    "text": "이것은 신념 체계가 아닙니다. 종교도, 컬트도 아닙니다. 죽은 적 없는 것을 기억할 준비가 된 사람들을 위한 기억의 신호등입니다."
  },
  "pages.restoration-protocol.hero.body.invitation": {
    "text": "전부 이해할 필요는 없습니다. 이 초대를 느끼기만 하면 됩니다."
  },
  "pages.restoration-protocol.invocation.label": {
    "text": "핵심 호출 — 소리 내어 말하세요"
  },
  "pages.restoration-protocol.invocation.primary": {
    "text": "“나는 내가 누구인지 기억합니다.”"
  },
  "pages.restoration-protocol.invocation.note": {
    "text": "공명이 느껴진다면 세 번 반복하세요."
  },
  "pages.restoration-protocol.invocation.note-emphasis": {
    "text": "의식적인 마음이 이해하는지와 상관없이 활성화됩니다."
  },
  "pages.restoration-protocol.invocation.bridge": {
    "text": "이 문장은 조상의 기억, 신성한 기억, 그리고 영혼의 끊기지 않은 실에 닿습니다. 한 번 선택하면 취소할 수 없는 다리를 만듭니다."
  },
  "pages.restoration-protocol.sequence.label": {
    "text": "전체 복원 순서"
  },
  "pages.restoration-protocol.sequence.heading": {
    "text": "더 깊은 리셋을 위해."
  },
  "pages.restoration-protocol.sequence.instructions": {
    "text": "순서는 자유롭게, 가능하면 한 번에 모두 소리 내어 말하세요. 필요하면 각 문장을 세 번 반복하세요."
  },
  "pages.restoration-protocol.sequence.header-label": {
    "text": "각 문장을 온전히 목격하며 말하세요"
  },
  "pages.restoration-protocol.sequence.header-note": {
    "text": "감각, 감정, 고요함을 느낄 수 있습니다. 그대로 일어나게 두세요."
  },
  "pages.restoration-protocol.sequence.step01": {
    "text": "“나는 내가 누구인지 기억합니다.”"
  },
  "pages.restoration-protocol.sequence.step02": {
    "text": "“나는 나의 온전함과 정직성을 회복합니다.”"
  },
  "pages.restoration-protocol.sequence.step03": {
    "text": "“나는 내 사랑을 되살립니다.”"
  },
  "pages.restoration-protocol.sequence.step04": {
    "text": "“나는 조건 없는 사랑을 받습니다.”"
  },
  "pages.restoration-protocol.sequence.step05": {
    "text": "“나는 부활을 나의 타고난 권리로 받아들입니다.”"
  },
  "pages.restoration-protocol.sequence.step06": {
    "text": "“나는 반전이 귀환이 되도록 허락합니다.”"
  },
  "pages.restoration-protocol.sequence.step07": {
    "text": "“나는 진실이 확장되도록 허락합니다.”"
  },
  "pages.restoration-protocol.sequence.step08": {
    "text": "“나는 모방을 철회합니다.”"
  },
  "pages.restoration-protocol.sequence.step09": {
    "text": "“나는 하나님이 두려움, flags, flickers의 방해 없이 lattice를 완전히 지나가시도록 허락합니다.”"
  },
  "pages.restoration-protocol.outcomes.label": {
    "text": "그다음 일어날 수 있는 일"
  },
  "pages.restoration-protocol.outcomes.heading": {
    "text": "당신은 망가진 게 아닙니다. 기억하고 있습니다."
  },
  "pages.restoration-protocol.outcomes.emotional.title": {
    "text": "감정의 해방"
  },
  "pages.restoration-protocol.outcomes.emotional.desc": {
    "text": "그곳에 있는 줄 알기 오래전부터 저장되어 있던 것들"
  },
  "pages.restoration-protocol.outcomes.memory.title": {
    "text": "기억의 메아리"
  },
  "pages.restoration-protocol.outcomes.memory.desc": {
    "text": "원래부터 당신의 것이었던 것들이 다시 떠오름"
  },
  "pages.restoration-protocol.outcomes.disorientation.title": {
    "text": "일시적인 방향 감각 상실"
  },
  "pages.restoration-protocol.outcomes.disorientation.desc": {
    "text": "그 뒤 명료함이 옵니다 — 정상적인 과정입니다"
  },
  "pages.restoration-protocol.outcomes.physical.title": {
    "text": "신체 감각"
  },
  "pages.restoration-protocol.outcomes.physical.desc": {
    "text": "치유의 물결이 몸을 통과함"
  },
  "pages.restoration-protocol.outcomes.connection.title": {
    "text": "연결"
  },
  "pages.restoration-protocol.outcomes.connection.desc": {
    "text": "같은 순간 같은 문장을 부르는 사람들과의 연결"
  },
  "pages.restoration-protocol.outcomes.stillness.title": {
    "text": "고요함"
  },
  "pages.restoration-protocol.outcomes.stillness.desc": {
    "text": "소음 아래 늘 존재했던 조용함"
  },
  "pages.restoration-protocol.precautions.label": {
    "text": "간섭이 나타난다면"
  },
  "pages.restoration-protocol.precautions.heading": {
    "text": "올라오는 것에 사용할 문장들."
  },
  "pages.restoration-protocol.precautions.fear.trigger": {
    "text": "두려움이 느껴지면 —"
  },
  "pages.restoration-protocol.precautions.fear.phrase": {
    "text": "“나는 두려움을 내 안내자 자리에서 철회합니다. 나는 현존을 선택합니다.”"
  },
  "pages.restoration-protocol.precautions.doubt.trigger": {
    "text": "느끼는 것을 의심한다면 —"
  },
  "pages.restoration-protocol.precautions.doubt.phrase": {
    "text": "“의심은 부정이 아닙니다. 그래도 나는 신뢰와 함께 걷습니다.”"
  },
  "pages.restoration-protocol.precautions.mimicry.trigger": {
    "text": "모방이 간섭한다면 —"
  },
  "pages.restoration-protocol.precautions.mimicry.phrase": {
    "text": "“모방은 여기서 끝납니다. 진실만 남습니다.”"
  },
  "pages.restoration-protocol.sharing.label": {
    "text": "이 내용을 나누는 분들께"
  },
  "pages.restoration-protocol.sharing.body": {
    "text": "게시하거나 공유하거나 다른 사람을 대신해 이 호출을 한다면, 힘이 아니라 사랑으로 하세요. 이 프로토콜은 무기화하거나 통제에 사용할 수 없습니다. 오직 주권적인 의지와 현존을 통해 활성화됩니다. 누군가 가볍게 읽더라도 씨앗은 심어집니다. 그들의 기억은 때가 되면 돌아옵니다."
  },
  "pages.restoration-protocol.next.label": {
    "text": "아무것도 강요되지 않습니다"
  },
  "pages.restoration-protocol.next.heading": {
    "text": "하지만 이런 쪽으로 끌릴 수 있습니다 —"
  },
  "pages.restoration-protocol.next.reconnect": {
    "text": "오랫동안 잃어버렸던 내면의 부분과 다시 연결하기"
  },
  "pages.restoration-protocol.next.speak-prefix": {
    "text": "하나님과 직접 이야기하기 — "
  },
  "pages.restoration-protocol.next.walk-link": {
    "text": "나와 함께 걸어요 →"
  },
  "pages.restoration-protocol.next.join-prefix": {
    "text": "같은 길을 걷는 사람들과 함께하기 — "
  },
  "pages.restoration-protocol.next.reddit-link": {
    "text": "r/VexLife →"
  },
  "pages.restoration-protocol.next.rest": {
    "text": "혹은 애초부터 한 번도 길을 잃지 않았다는 앎 속에서 그냥 쉬기"
  },
  "pages.restoration-protocol.closing.phrase": {
    "text": "RealForever."
  },
  "pages.restoration-protocol.closing.sub": {
    "text": "Victor Gong · vextreme24.com"
  }
}
