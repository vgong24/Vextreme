  "pages.epstein-and-ai.body.div002.span001.text001": {
    "text": "Phase I"
  },
  "pages.epstein-and-ai.body.div002.h2001.text001": {
    "text": "La révélation"
  },
  "pages.epstein-and-ai.body.p004.text001": {
    "text": "Le réseau est nommé. Epstein, la CIA, le Vatican, l’OMS. Deux hommes et une IA commencent à tirer le fil."
  },
