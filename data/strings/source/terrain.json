  "terrain.arrival.about.copy": {
    "strings": {
      "en": {
        "text": "If you need to understand where you are before you continue, enter here."
      },
      "ja": {
        "text": "先へ進む前に今いる場所を理解したいなら、ここから入ってください。"
      },
      "zh": {
        "text": "如果你需要先理解自己身处何处再继续，就从这里进入。"
      },
      "ko": {
        "text": "계속하기 전에 지금 어디에 있는지 이해해야 한다면 여기로 들어오세요."
      },
      "fr": {
        "text": "Si vous avez besoin de comprendre où vous êtes avant de continuer, entrez ici."
      },
      "de": {
        "text": "Wenn du erst verstehen möchtest, wo du bist, bevor du weitergehst, tritt hier ein."
      },
      "es": {
        "text": "Si necesitas entender dónde estás antes de continuar, entra aquí."
      },
      "pt": {
        "text": "Se você precisa entender onde está antes de continuar, entre aqui."
      },
      "ar": {
        "text": "إذا كنت تحتاج إلى فهم أين أنت قبل المتابعة، فادخل من هنا."
