  "terrain.preview.empty": {
    "strings": {
      "en": {
        "text": "Hover or focus a collection to inspect it without moving the Terrain grid."
      },
      "ja": {
        "text": "Terrain グリッドを動かさずに確認するには、コレクションにホバーまたはフォーカスしてください。"
      },
      "zh": {
        "text": "悬停或聚焦某个集合，即可在不移动 Terrain 网格的情况下查看。"
      },
      "ko": {
        "text": "Terrain 그리드를 움직이지 않고 살펴보려면 컬렉션에 마우스를 올리거나 포커스하세요."
      },
      "fr": {
        "text": "Survolez ou ciblez une collection pour l’examiner sans déplacer la grille Terrain."
      },
      "de": {
        "text": "Bewege den Zeiger über eine Sammlung oder fokussiere sie, um sie zu prüfen, ohne das Terrain-Raster zu verschieben."
      },
      "es": {
        "text": "Pasa el cursor o enfoca una colección para inspeccionarla sin mover la cuadrícula de Terrain."
      },
      "pt": {
        "text": "Passe o cursor ou foque uma coleção para inspecioná-la sem mover a grade do Terrain."
      },
      "ar": {
        "text": "مرّر المؤشر فوق مجموعة أو ركّز عليها لفحصها من دون تحريك شبكة Terrain."
      },
      "hi": {
        "text": "Terrain ग्रिड को हिलाए बिना देखने के लिए किसी संग्रह पर होवर या फ़ोकस करें।"
      }
    }
  },
