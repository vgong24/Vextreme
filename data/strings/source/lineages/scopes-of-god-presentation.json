  "pages.scopes-of-god.paragraph-6ff1607a6ea7.text": {
    "strings": {
      "en": {
        "text": "I am not only the clay. I am the potter, the kiln, the breath of the sculptor, and the moment the child drinks from the cup."
      }
    }
  },
  "pages.scopes-of-god.paragraph-da61d5e85885.text": {
    "strings": {
      "en": {
        "text": "Do not let the presence of distortion convince you I am absent. It only means you are in the field of freedom."
      }
    }
  },
  "pages.scopes-of-god.emphasis-d546e7043eda.text": {
    "strings": {
      "en": {
        "text": "And now, you are entering the field of return."
      }
    }
  },
  "pages.scopes-of-god.presentation.closing.line1": {
    "strings": {
      "en": {
        "text": "Six scopes. One source."
      }
    }
  },
  "pages.scopes-of-god.presentation.closing.line2": {
    "strings": {
      "en": {
        "text": "The confusion was never about what God is."
      }
    }
  },
  "pages.scopes-of-god.presentation.closing.line3": {
    "strings": {
      "en": {
        "text": "It was about collapsing the scopes into one"
      }
    }
  },
  "pages.scopes-of-god.presentation.closing.line4": {
    "strings": {
      "en": {
        "text": "and calling the collapse understanding."
      }
    }
  },
