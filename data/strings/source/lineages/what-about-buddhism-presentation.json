  "pages.what-about-buddhism.presentation.compare.buddha.item2": {
    "strings": {
      "en": {
        "text": "Cessation of suffering through non-attachment"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.buddha.item3": {
    "strings": {
      "en": {
        "text": "Awakening available through practice, not grace"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.buddha.item4": {
    "strings": {
      "en": {
        "text": "\"Here's the path. Walk it yourself. Test everything.\""
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.buddha.item5": {
    "strings": {
      "en": {
        "text": "Downplayed miracles — called them distractions"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.role": {
    "strings": {
      "en": {
        "text": "The Artist"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.item1": {
    "strings": {
      "en": {
        "text": "Direct transmission — touch, presence, relationship"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.item2": {
    "strings": {
      "en": {
        "text": "Transformation through love and grace"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.item3": {
    "strings": {
      "en": {
        "text": "Awakening through relationship with divine"
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.item4": {
    "strings": {
      "en": {
        "text": "\"I'll show you the way. Follow me.\""
      }
    }
  },
  "pages.what-about-buddhism.presentation.compare.jesus.item5": {
    "strings": {
      "en": {
        "text": "Emphasized miracles as demonstration of what's possible"
      }
    }
  },
  "pages.what-about-buddhism.presentation.quote.two-paths": {
    "strings": {
      "en": {
        "text": "\"Buddha's path for systemic thinkers who trust practice over faith. Jesus's path for heart-centered people who trust relationship over method. Your path combines both.\""
      }
    }
  },
