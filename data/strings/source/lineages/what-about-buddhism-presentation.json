        "text": "\"I and the Father are one.\""
      }
    }
  },
  "pages.what-about-buddhism.presentation.quote.buddha-anatta": {
    "strings": {
      "en": {
        "text": "\"Anatta\" — no separate self exists."
      }
    }
  },
