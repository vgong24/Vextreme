  "pages.the-witness-outlives-the-window.hero.lede": {
    "strings": {
      "en": {
        "text": "Across two nights of dream reporting, power first arrives as joy rather than struggle. A flexible vessel then carries an unfinished journey while perception is still being prepared. The dream sharpens into a continuity problem: writing disappears from a transparent surface while the original witness reads it aloud so another participant can preserve it elsewhere. Victor later recognizes the correspondence with recording fading dreams into durable, attributable archives."
      }
    }
  },
