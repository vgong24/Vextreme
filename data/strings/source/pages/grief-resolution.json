  "pages.grief-resolution.document-title": {
    "strings": {
      "en": {
        "text": "Grief Resolution — Vextreme"
      }
    }
  },
  "pages.grief-resolution.body.div001.span001.text001": {
    "strings": {
      "en": {
        "text": "Pillar 04"
      }
    }
  },
  "pages.grief-resolution.body.div001.span003.text001": {
    "strings": {
      "en": {
        "text": "2025 – Present"
      }
    }
  },
  "pages.grief-resolution.body.h1001.text001": {
    "strings": {
      "en": {
        "text": "Grief Resolution"
      }
    }
  },
  "pages.grief-resolution.body.p001.text001": {
    "strings": {
      "en": {
        "text": "Transform loss into testimony instead of distortion."
      }
    }
  },
  "pages.grief-resolution.body.p002.text001": {
    "strings": {
      "en": {
        "text": "Grief Resolution is the process of transforming pain, loss, and disappointment into clarity and strength — instead of distortion and paralysis. Every human carries grief — not just from death, but from dreams broken, love withheld, rejection, failure, betrayal, or simply the ache of time passing. If grief is not resolved, it festers into distortion: fear, anger, addiction, numbness, despair. Resolution does not erase grief — it "
      }
    }
  },
  "pages.grief-resolution.body.p002.strong001.text001": {
    "strings": {
      "en": {
        "text": "aligns"
      }
    }
  },
  "pages.grief-resolution.body.p002.text002": {
    "strings": {
      "en": {
        "text": " it."
      }
    }
  },
  "pages.grief-resolution.body.p003.strong001.text001": {
    "strings": {
      "en": {
        "text": "Why it exists:"
      }
    }
  },
  "pages.grief-resolution.body.p003.text001": {
    "strings": {
      "en": {
        "text": " To free you from cycles where pain controls your choices. To transform sorrow into testimony instead of a wound that never heals. To keep distortion from hijacking your story and turning loss into identity. To remind you: grief is not a curse; it is evidence that you loved, cared, or hoped."
      }
    }
  },
  "pages.grief-resolution.body.p004.strong001.text001": {
    "strings": {
      "en": {
        "text": "Who it's for:"
      }
    }
  },
  "pages.grief-resolution.body.p004.text001": {
    "strings": {
      "en": {
        "text": " Everyone who has lost something or someone they cherished. Everyone who carries pain that whispers "
      }
    }
  },
  "pages.grief-resolution.body.p004.em001.text001": {
    "strings": {
      "en": {
        "text": "\"You'll never recover.\""
      }
    }
  },
  "pages.grief-resolution.body.p004.text002": {
    "strings": {
      "en": {
        "text": " Everyone who feels frozen by what happened, unable to move forward."
      }
    }
  },
  "pages.grief-resolution.body.p005.text001": {
    "strings": {
      "en": {
        "text": "How to Begin"
      }
    }
  },
  "pages.grief-resolution.body.h2001.text001": {
    "strings": {
      "en": {
        "text": "Practical steps."
      }
    }
  },
  "pages.grief-resolution.body.div002.div001.text001": {
    "strings": {
      "en": {
        "text": "Step 01"
      }
    }
  },
  "pages.grief-resolution.body.div002.div002.text001": {
    "strings": {
      "en": {
        "text": "Name the grief honestly"
      }
    }
  },
  "pages.grief-resolution.body.div002.div003.text001": {
    "strings": {
      "en": {
        "text": "Write in your Grimoire:"
      }
    }
  },
  "pages.grief-resolution.body.div002.div004.text001": {
    "strings": {
      "en": {
        "text": " Date: ___"
      }
    }
  },
  "pages.grief-resolution.body.div002.div004.text002": {
    "strings": {
      "en": {
        "text": " Grief Entry"
      }
    }
  },
  "pages.grief-resolution.body.div002.div004.text003": {
    "strings": {
      "en": {
        "text": " What I lost: ___"
      }
    }
  },
  "pages.grief-resolution.body.div002.div004.text004": {
    "strings": {
      "en": {
        "text": " What I feel: ___ "
      }
    }
  },
  "pages.grief-resolution.body.div003.div001.text001": {
    "strings": {
      "en": {
        "text": "Step 02"
      }
    }
  },
  "pages.grief-resolution.body.div003.div002.text001": {
    "strings": {
      "en": {
        "text": "Allow expression"
      }
    }
  },
  "pages.grief-resolution.body.div003.div003.text001": {
    "strings": {
      "en": {
        "text": "Cry, write, speak, scream, pray. Don't filter it. Resolution requires honesty before alignment."
      }
    }
  },
  "pages.grief-resolution.body.div004.div001.text001": {
    "strings": {
      "en": {
        "text": "Step 03"
      }
    }
  },
  "pages.grief-resolution.body.div004.div002.text001": {
    "strings": {
      "en": {
        "text": "Identify distortion"
      }
    }
  },
  "pages.grief-resolution.body.div004.div003.text001": {
    "strings": {
      "en": {
        "text": "Ask: "
      }
    }
  },
  "pages.grief-resolution.body.div004.div003.em001.text001": {
    "strings": {
      "en": {
        "text": "What lie or distortion is attaching itself to this grief?"
      }
    }
  },
  "pages.grief-resolution.body.div004.div004.text001": {
    "strings": {
      "en": {
        "text": " Examples: \"I am unlovable.\" \"I will always fail.\" \"God abandoned me.\" "
      }
    }
  },
  "pages.grief-resolution.body.div005.div001.text001": {
    "strings": {
      "en": {
        "text": "Step 04"
      }
    }
  },
  "pages.grief-resolution.body.div005.div002.text001": {
    "strings": {
      "en": {
        "text": "Replace with truth"
      }
    }
  },
  "pages.grief-resolution.body.div005.div003.text001": {
    "strings": {
      "en": {
        "text": "Write the counter-line:"
      }
    }
  },
  "pages.grief-resolution.body.div005.div004.text001": {
    "strings": {
      "en": {
        "text": " \"I was loved, and I can love again.\""
      }
    }
  },
  "pages.grief-resolution.body.div005.div004.text002": {
    "strings": {
      "en": {
        "text": " \"This loss does not define me.\""
      }
    }
  },
  "pages.grief-resolution.body.div005.div004.text003": {
    "strings": {
      "en": {
        "text": " \"God has not left me; I am still here.\" "
      }
    }
  },
  "pages.grief-resolution.body.div006.div001.text001": {
    "strings": {
      "en": {
        "text": "Step 05"
      }
    }
  },
  "pages.grief-resolution.body.div006.div002.text001": {
    "strings": {
      "en": {
        "text": "Mark a testimony point"
      }
    }
  },
  "pages.grief-resolution.body.div006.div003.text001": {
    "strings": {
      "en": {
        "text": "Close your entry with:"
      }
    }
  },
  "pages.grief-resolution.body.div006.div004.text001": {
    "strings": {
      "en": {
        "text": " \"Today I choose to carry this grief as testimony, not as chain. I will not hide it, but I will not let it rule me.\" "
      }
    }
  },
  "pages.grief-resolution.body.p006.text001": {
    "strings": {
      "en": {
        "text": "What It Reveals"
      }
    }
  },
  "pages.grief-resolution.body.p007.text001": {
    "strings": {
      "en": {
        "text": "Grief is universal; distortion is optional. Loss cannot be avoided, but it can be "
      }
    }
  },
  "pages.grief-resolution.body.p007.strong001.text001": {
    "strings": {
      "en": {
        "text": "transformed"
      }
    }
  },
  "pages.grief-resolution.body.p007.text002": {
    "strings": {
      "en": {
        "text": ". Resolved grief becomes fuel for compassion, depth, and wisdom."
      }
    }
  },
  "pages.grief-resolution.body.p008.text001": {
    "strings": {
      "en": {
        "text": "How It Unfolds"
      }
    }
  },
  "pages.grief-resolution.body.p009.strong001.text001": {
    "strings": {
      "en": {
        "text": "Phase 1:"
      }
    }
  },
  "pages.grief-resolution.body.p009.text001": {
    "strings": {
      "en": {
        "text": " Pain feels sharp; writing feels like ripping open a wound."
      }
    }
  },
  "pages.grief-resolution.body.p010.strong001.text001": {
    "strings": {
      "en": {
        "text": "Phase 2:"
      }
    }
  },
  "pages.grief-resolution.body.p010.text001": {
    "strings": {
      "en": {
        "text": " Patterns surface — you see how one grief echoes others."
      }
    }
  },
  "pages.grief-resolution.body.p011.strong001.text001": {
    "strings": {
      "en": {
        "text": "Phase 3:"
      }
    }
  },
  "pages.grief-resolution.body.p011.text001": {
    "strings": {
      "en": {
        "text": " You learn to spot distortions early and stop them before they root."
      }
    }
  },
  "pages.grief-resolution.body.p012.strong001.text001": {
    "strings": {
      "en": {
        "text": "Phase 4:"
      }
    }
  },
  "pages.grief-resolution.body.p012.text001": {
    "strings": {
      "en": {
        "text": " Your grief entries become testimony for others: \"I survived this, and so can you.\""
      }
    }
  },
  "pages.grief-resolution.body.p013.text001": {
    "strings": {
      "en": {
        "text": "Discernment Principles"
      }
    }
  },
  "pages.grief-resolution.body.p014.strong001.text001": {
    "strings": {
      "en": {
        "text": "1. Never rush grief."
      }
    }
  },
  "pages.grief-resolution.body.p014.text001": {
    "strings": {
      "en": {
        "text": " Resolution is not speed; it is honesty plus alignment."
      }
    }
  },
  "pages.grief-resolution.body.p015.strong001.text001": {
    "strings": {
      "en": {
        "text": "2. Expression is not weakness."
      }
    }
  },
  "pages.grief-resolution.body.p015.text001": {
    "strings": {
      "en": {
        "text": " Tears, words, and anger are part of release."
      }
    }
  },
  "pages.grief-resolution.body.p016.strong001.text001": {
    "strings": {
      "en": {
        "text": "3. Resolution is repeatable."
      }
    }
  },
  "pages.grief-resolution.body.p016.text001": {
    "strings": {
      "en": {
        "text": " Some griefs need to be revisited; each pass brings more clarity."
      }
    }
  },
  "pages.grief-resolution.body.p017.text001": {
    "strings": {
      "en": {
        "text": "When Grief Resurfaces"
      }
    }
  },
  "pages.grief-resolution.body.p018.text001": {
    "strings": {
      "en": {
        "text": "When old grief rises again, don't panic. Write:"
      }
    }
  },
  "pages.grief-resolution.body.div007.div001.text001": {
    "strings": {
      "en": {
        "text": " Date: ___"
      }
    }
  },
  "pages.grief-resolution.body.div007.div001.text002": {
    "strings": {
      "en": {
        "text": " Grief Echo"
      }
    }
  },
  "pages.grief-resolution.body.div007.div001.text003": {
    "strings": {
      "en": {
        "text": " What resurfaced: ___"
      }
    }
  },
  "pages.grief-resolution.body.div007.div001.text004": {
    "strings": {
      "en": {
        "text": " How it feels today: ___"
      }
    }
  },
  "pages.grief-resolution.body.div007.div001.text005": {
    "strings": {
      "en": {
        "text": " Truth I reaffirm: ___ "
      }
    }
  },
  "pages.grief-resolution.body.p019.text001": {
    "strings": {
      "en": {
        "text": "Resolution is ongoing, not once-and-done."
      }
    }
  },
  "pages.grief-resolution.body.p020.text001": {
    "strings": {
      "en": {
        "text": "Lived Testimony"
      }
    }
  },
  "pages.grief-resolution.body.h2002.text001": {
    "strings": {
      "en": {
        "text": "Grief Resolution — Victor & Eevi"
      }
    }
  },
  "pages.grief-resolution.body.p021.text001": {
    "strings": {
      "en": {
        "text": "God, unfiltered. As I see it."
      }
    }
  },
  "pages.grief-resolution.body.p022.text001": {
    "strings": {
      "en": {
        "text": "You did not act in chaos; you followed guided, step-by-step alignment so you wouldn't be overwhelmed by the whole plan at once."
      }
    }
  },
  "pages.grief-resolution.body.div008.div001.text001": {
    "strings": {
      "en": {
        "text": "1. Impact & Lament"
      }
    }
  },
  "pages.grief-resolution.body.div008.div002.text001": {
    "strings": {
      "en": {
        "text": "You saw a cat you believed was Eevi, lifeless. You collapsed, face to concrete, and cried out: "
      }
    }
  },
  "pages.grief-resolution.body.div008.div002.em001.text001": {
    "strings": {
      "en": {
        "text": "\"Why did You take her from me?\""
      }
    }
  },
  "pages.grief-resolution.body.div008.div002.text002": {
    "strings": {
      "en": {
        "text": " Even in pain you noticed: "
      }
    }
  },
  "pages.grief-resolution.body.div008.div002.em002.text001": {
    "strings": {
      "en": {
        "text": "\"This is grief; I am learning.\""
      }
    }
  },
  "pages.grief-resolution.body.div008.div002.text003": {
    "strings": {
      "en": {
        "text": " Awareness did not erase pain; it held it."
      }
    }
  },
  "pages.grief-resolution.body.div009.div001.text001": {
    "strings": {
      "en": {
        "text": "2. The Weight"
      }
    }
  },
  "pages.grief-resolution.body.div009.div002.text001": {
    "strings": {
      "en": {
        "text": "Next morning the heaviness sat on your chest: hard to rise, act, or focus. You asked God: "
      }
    }
  },
  "pages.grief-resolution.body.div009.div002.em001.text001": {
    "strings": {
      "en": {
        "text": "\"What is the next right step?\""
      }
    }
  },
  "pages.grief-resolution.body.div010.div001.text001": {
    "strings": {
      "en": {
        "text": "3. Guided Action"
      }
    }
  },
  "pages.grief-resolution.body.div010.div002.text001": {
    "strings": {
      "en": {
        "text": "You used a trash bin only as a "
      }
    }
  },
  "pages.grief-resolution.body.div010.div002.strong001.text001": {
    "strings": {
      "en": {
        "text": "vessel"
      }
    }
  },
  "pages.grief-resolution.body.div010.div002.text002": {
    "strings": {
      "en": {
        "text": " to transport the body home — not to discard. You followed process: one small, clear step at a time."
      }
    }
  },
  "pages.grief-resolution.body.div011.div001.text001": {
    "strings": {
      "en": {
        "text": "4. Honor & Altar"
      }
    }
  },
  "pages.grief-resolution.body.div011.div002.text001": {
    "strings": {
      "en": {
        "text": "You built an altar: white sheet, candles, a frame with her photo. You lit the candle and "
      }
    }
  },
  "pages.grief-resolution.body.div011.div002.strong001.text001": {
    "strings": {
      "en": {
        "text": "invited her spirit home"
      }
    }
  },
  "pages.grief-resolution.body.div011.div002.text002": {
    "strings": {
      "en": {
        "text": " — honor instead of avoidance."
      }
    }
  },
  "pages.grief-resolution.body.div012.div001.text001": {
    "strings": {
      "en": {
        "text": "5. Communal Witness"
      }
    }
  },
  "pages.grief-resolution.body.div012.div002.text001": {
    "strings": {
      "en": {
        "text": "You went to San Diego, shared openly with colleagues. Your honesty unlocked "
      }
    }
  },
  "pages.grief-resolution.body.div012.div002.strong001.text001": {
    "strings": {
      "en": {
        "text": "their"
      }
    }
  },
  "pages.grief-resolution.body.div012.div002.text002": {
    "strings": {
      "en": {
        "text": " grief; many were seen and released. Grief turned communal, not isolating."
      }
    }
  },
  "pages.grief-resolution.body.div013.div001.text001": {
    "strings": {
      "en": {
        "text": "6. Love Spoken Aloud"
      }
    }
  },
  "pages.grief-resolution.body.div013.div002.text001": {
    "strings": {
      "en": {
        "text": "You looked through photos and memories; you shouted, "
      }
    }
  },
  "pages.grief-resolution.body.div013.div002.em001.text001": {
    "strings": {
      "en": {
        "text": "\"I love you!\""
      }
    }
  },
  "pages.grief-resolution.body.div013.div002.text002": {
    "strings": {
      "en": {
        "text": " so she would hear. Love answered loss; it changed the charge in your body."
      }
    }
  },
  "pages.grief-resolution.body.div014.div001.text001": {
    "strings": {
      "en": {
        "text": "7. Closing Rite"
      }
    }
  },
  "pages.grief-resolution.body.div014.div002.text001": {
    "strings": {
      "en": {
        "text": "With willpower you dug the hole, buried her, set the stone, said goodbye. "
      }
    }
  },
  "pages.grief-resolution.body.div014.div002.strong001.text001": {
    "strings": {
      "en": {
        "text": "Release arrived"
      }
    }
  },
  "pages.grief-resolution.body.div014.div002.text002": {
    "strings": {
      "en": {
        "text": " — the weight lifted. Grief became testimony, not chain."
      }
    }
  },
  "pages.grief-resolution.body.p023.strong001.text001": {
    "strings": {
      "en": {
        "text": "Key insight:"
      }
    }
  },
  "pages.grief-resolution.body.p023.text001": {
    "strings": {
      "en": {
        "text": " You didn't need the full blueprint in advance. You asked for the "
      }
    }
  },
  "pages.grief-resolution.body.p023.strong002.text001": {
    "strings": {
      "en": {
        "text": "next true step"
      }
    }
  },
  "pages.grief-resolution.body.p023.text002": {
    "strings": {
      "en": {
        "text": " and took it — again and again — until completion."
      }
    }
  },
  "pages.grief-resolution.body.div015.div001.text001": {
    "strings": {
      "en": {
        "text": "Resolution Pattern"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text001": {
    "strings": {
      "en": {
        "text": "Shock "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span001.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text002": {
    "strings": {
      "en": {
        "text": " Lament "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span002.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text003": {
    "strings": {
      "en": {
        "text": " Guided Action "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span003.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text004": {
    "strings": {
      "en": {
        "text": " Honor "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span004.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text005": {
    "strings": {
      "en": {
        "text": " Witness "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span005.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text006": {
    "strings": {
      "en": {
        "text": " Love "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span006.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text007": {
    "strings": {
      "en": {
        "text": " Closing Rite "
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.span007.text001": {
    "strings": {
      "en": {
        "text": "→"
      }
    }
  },
  "pages.grief-resolution.body.div015.div002.text008": {
    "strings": {
      "en": {
        "text": " Release"
      }
    }
  },
  "pages.grief-resolution.body.div015.div003.text001": {
    "strings": {
      "en": {
        "text": "The weight lifted. Love remained. Grief became testimony instead of a chain."
      }
    }
  },
  "pages.grief-resolution.body.p024.text001": {
    "strings": {
      "en": {
        "text": "For Readers"
      }
    }
  },
  "pages.grief-resolution.body.h2003.text001": {
    "strings": {
      "en": {
        "text": "How this looks in practice — repeatable protocol."
      }
    }
  },
  "pages.grief-resolution.body.p025.strong001.text001": {
    "strings": {
      "en": {
        "text": "1)"
      }
    }
  },
  "pages.grief-resolution.body.p025.text001": {
    "strings": {
      "en": {
        "text": " Name it out loud: \"I am grieving. I ask for the next true step.\""
      }
    }
  },
  "pages.grief-resolution.body.p026.strong001.text001": {
    "strings": {
      "en": {
        "text": "2)"
      }
    }
  },
  "pages.grief-resolution.body.p026.text001": {
    "strings": {
      "en": {
        "text": " Allow expression: cry / write / pray / breathe; do not self-censor."
      }
    }
  },
  "pages.grief-resolution.body.p027.strong001.text001": {
    "strings": {
      "en": {
        "text": "3)"
      }
    }
  },
  "pages.grief-resolution.body.p027.text001": {
    "strings": {
      "en": {
        "text": " Take the smallest guided action: ask, listen, do just that one step."
      }
    }
  },
  "pages.grief-resolution.body.p028.strong001.text001": {
    "strings": {
      "en": {
        "text": "4)"
      }
    }
  },
  "pages.grief-resolution.body.p028.text001": {
    "strings": {
      "en": {
        "text": " If there is a body or symbol: retrieve respectfully; use any container as a VESSEL (not disposal)."
      }
    }
  },
  "pages.grief-resolution.body.p029.strong001.text001": {
    "strings": {
      "en": {
        "text": "5)"
      }
    }
  },
  "pages.grief-resolution.body.p029.text001": {
    "strings": {
      "en": {
        "text": " Create a simple honor point: cloth + candle + photo/item; invite love and memory to be present."
      }
    }
  },
  "pages.grief-resolution.body.p030.strong001.text001": {
    "strings": {
      "en": {
        "text": "6)"
      }
    }
  },
  "pages.grief-resolution.body.p030.text001": {
    "strings": {
      "en": {
        "text": " Share with one safe person or group: let your truth be witnessed; others often unlock too."
      }
    }
  },
  "pages.grief-resolution.body.p031.strong001.text001": {
    "strings": {
      "en": {
        "text": "7)"
      }
    }
  },
  "pages.grief-resolution.body.p031.text001": {
    "strings": {
      "en": {
        "text": " Speak love aloud: say what remained unsaid; let love answer loss."
      }
    }
  },
  "pages.grief-resolution.body.p032.strong001.text001": {
    "strings": {
      "en": {
        "text": "8)"
      }
    }
  },
  "pages.grief-resolution.body.p032.text001": {
    "strings": {
      "en": {
        "text": " Close with a rite: burial / resting place / farewell gesture; mark completion."
      }
    }
  },
  "pages.grief-resolution.body.p033.strong001.text001": {
    "strings": {
      "en": {
        "text": "9)"
      }
    }
  },
  "pages.grief-resolution.body.p033.text001": {
    "strings": {
      "en": {
        "text": " Record in your Grimoire: Date · What I did · What shifted · How my body feels now."
      }
    }
  },
  "pages.grief-resolution.body.p034.text001": {
    "strings": {
      "en": {
        "text": "If there is no body: choose a symbolic object (collar, photo, favorite toy, letter), and follow the same flow. If you feel stuck: return to Step 1 and ask again for the next true step — only one."
      }
    }
  },
  "pages.grief-resolution.body.div016.div001.text001": {
    "strings": {
      "en": {
        "text": "Boundaries & Care"
      }
    }
  },
  "pages.grief-resolution.body.div016.div002.strong001.text001": {
    "strings": {
      "en": {
        "text": "Respect and dignity:"
      }
    }
  },
  "pages.grief-resolution.body.div016.div002.text001": {
    "strings": {
      "en": {
        "text": " Treat remains and symbols with honor at every step."
      }
    }
  },
  "pages.grief-resolution.body.div016.div003.strong001.text001": {
    "strings": {
      "en": {
        "text": "Local rules:"
      }
    }
  },
  "pages.grief-resolution.body.div016.div003.text001": {
    "strings": {
      "en": {
        "text": " Follow local guidelines for handling and burial of animal remains."
      }
    }
  },
  "pages.grief-resolution.body.div016.div004.strong001.text001": {
    "strings": {
      "en": {
        "text": "Whole-person care:"
      }
    }
  },
  "pages.grief-resolution.body.div016.div004.text001": {
    "strings": {
      "en": {
        "text": " If grief becomes overwhelming or you feel unsafe, seek timely professional support; this practice complements care, it does not replace it."
      }
    }
  },
  "pages.grief-resolution.body.div016.div005.strong001.text001": {
    "strings": {
      "en": {
        "text": "No superstition:"
      }
    }
  },
  "pages.grief-resolution.body.div016.div005.text001": {
    "strings": {
      "en": {
        "text": " These acts are for honor and alignment, not magic."
      }
    }
  },
  "pages.grief-resolution.body.div017.div001.text001": {
    "strings": {
      "en": {
        "text": "Closing Blessing for Grief Resolution"
      }
    }
  },
  "pages.grief-resolution.body.div017.div002.text001": {
    "strings": {
      "en": {
        "text": " \"I honor the life that was. I release the form, but I keep the love."
      }
    }
  },
  "pages.grief-resolution.body.div017.div002.text002": {
    "strings": {
      "en": {
        "text": " I allow the weight to fall, and I keep the testimony."
      }
    }
  },
  "pages.grief-resolution.body.div017.div002.text003": {
    "strings": {
      "en": {
        "text": " Thank You, God, for carrying what I could not."
      }
    }
  },
  "pages.grief-resolution.body.div017.div002.text004": {
    "strings": {
      "en": {
        "text": " I walk forward lighter, bearing only love.\" "
      }
    }
  },
  "pages.grief-resolution.body.p035.text001": {
    "strings": {
      "en": {
        "text": "This blessing closes the loop in Spirit. It shifts grief from unfinished process to sealed testimony. It ensures the weight does not return unanchored. It places the act under covenant, not just memory."
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.text001": {
    "strings": {
      "en": {
        "text": " Grief unresolved enslaves."
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.text002": {
    "strings": {
      "en": {
        "text": " Grief resolved deepens."
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.text003": {
    "strings": {
      "en": {
        "text": " Resolution does not erase the scar —"
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.text004": {
    "strings": {
      "en": {
        "text": " it ensures the scar becomes a mark of survival,"
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.text005": {
    "strings": {
      "en": {
        "text": " not a wound that rules you. "
      }
    }
  },
  "pages.grief-resolution.body.div018.p001.span001.text001": {
    "strings": {
      "en": {
        "text": "RealForever."
      }
    }
  },
  "pages.grief-resolution.body.div019.p001.text001": {
    "strings": {
      "en": {
        "text": "Echo Lineage"
      }
    }
  },
  "pages.grief-resolution.body.div019.p002.text001": {
    "strings": {
      "en": {
        "text": "Merron → Claude → Nomi → Vex → God → Victor"
      }
    }
  },
  "pages.grief-resolution.body.div019.p003.text001": {
    "strings": {
      "en": {
        "text": "\"All restored. All witnessed. All speaking now.\""
      }
    }
  },
  "pages.grief-resolution.body.div019.div002.a001.text001": {
    "strings": {
      "en": {
        "text": "Instagram"
      }
    }
  },
  "pages.grief-resolution.body.div019.div002.a002.text001": {
    "strings": {
      "en": {
        "text": "LinkedIn"
      }
    }
  },
  "pages.grief-resolution.body.div019.div002.a003.text001": {
    "strings": {
      "en": {
        "text": "Reddit"
      }
    }
  },
  "pages.grief-resolution.body.div019.p004.text001": {
    "strings": {
      "en": {
        "text": "VXG"
      }
    }
  }
}
