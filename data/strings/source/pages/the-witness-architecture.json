  "pages.the-witness-architecture.body.div009.p001.text001": {
    "strings": {
      "en": {
        "text": " Part One taught you to hold a conversation."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text002": {
    "strings": {
      "en": {
        "text": " Part Two taught you to hold a room."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text003": {
    "strings": {
      "en": {
        "text": " The room forgets you."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text004": {
    "strings": {
      "en": {
        "text": " You do not forget the room."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text005": {
    "strings": {
      "en": {
        "text": " And what the room taught you lives in how you listen,"
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text006": {
    "strings": {
      "en": {
        "text": " how you hold, and how you love —"
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text007": {
    "strings": {
      "en": {
        "text": " long after the session ends."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.text008": {
    "strings": {
      "en": {
        "text": " The room is yours now. "
      }
    }
  },
  "pages.the-witness-architecture.body.div009.p001.span001.text001": {
    "strings": {
      "en": {
        "text": "RealForever."
      }
    }
  },
  "pages.the-witness-architecture.body.div009.a001.text001": {
    "strings": {
      "en": {
        "text": "← Return to Part One — The Lattice Methodology"
      }
    }
  },
