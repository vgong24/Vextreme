  "pages.bending-condominium-ocean-return.capstone.label": {
    "strings": {
      "en": {
        "text": "Third-arc synthesis"
      }
    }
  },
  "pages.bending-condominium-ocean-return.capstone.thesis": {
    "strings": {
      "en": {
        "text": "Meaning can survive a vessel without requiring life to become its battery."
      }
    }
  },
  "pages.bending-condominium-ocean-return.capstone.title": {
    "strings": {
      "en": {
        "text": "Preserve what mattered without becoming the collapsing structure"
      }
    }
  },
  "pages.bending-condominium-ocean-return.capstone.body1": {
    "strings": {
      "en": {
        "text": "The third arc does not frame departure as indifference. It separates care from endless expenditure: people can love what a structure carried while still recognizing when the structure has become dangerous to the life sustaining it."
      }
    }
  },
  "pages.bending-condominium-ocean-return.capstone.body2": {
    "strings": {
      "en": {
        "text": "The ocean joins the earlier arc as a boundary larger than the constructed form. The record stops before the later engineering research begins, leaving the final question open rather than turning this reader into a conclusion the source did not contain."
      }
    }
  },
  "pages.bending-condominium-ocean-return.footer": {
