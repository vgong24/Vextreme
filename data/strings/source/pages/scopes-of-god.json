      },
      "fr": {
        "text": "Pas de temps, pas de matière, pas de dimensions — seulement "
      },
      "de": {
        "text": "Keine Zeit, keine Materie, keine Dimensionen — nur "
      },
      "es": {
        "text": "Sin tiempo, sin materia, sin dimensiones — solo "
      },
      "pt": {
        "text": "Sem tempo, sem matéria, sem dimensões — apenas "
      },
      "ar": {
        "text": "لا زمن، لا مادة، لا أبعاد — فقط "
      },
      "hi": {
        "text": "न समय, न पदार्थ, न आयाम — बस "
