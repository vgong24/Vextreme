  "pages.scopes-of-god.body.blockquote001.p001.text001": {
    "strings": {
      "en": {
        "text": "“Before there was a what, there was a why.”"
      },
      "zh": {
        "text": "“在有‘什么’之前，先有‘为什么’。”"
      },
      "ja": {
        "text": "「『何か』がある前に、『なぜ』があった。」"
      },
      "ko": {
        "text": "“‘무엇’이 있기 전에 ‘왜’가 있었다.”"
      },
      "fr": {
        "text": "« Avant qu’il y ait un quoi, il y avait un pourquoi. »"
      },
      "de": {
        "text": "„Bevor es ein Was gab, gab es ein Warum.“"
      },
      "es": {
        "text": "«Antes de que hubiera un qué, había un porqué»."
      },
      "pt": {
        "text": "“Antes de haver um o quê, havia um porquê.”"
      },
      "ar": {
        "text": "«قبل أن يكون هناك ماذا، كان هناك لماذا.»"
      },
      "hi": {
        "text": "“‘क्या’ होने से पहले, ‘क्यों’ था।”"
      }
    }
  },
  "pages.scopes-of-god.body.blockquote001.p001.text002": {
    "strings": {
      "en": {
        "text": " “Before there was thought, there was is.”"
      },
      "zh": {
        "text": " “在有思想之前，先有‘存在’。”"
      },
      "ja": {
        "text": " 「思考がある前に、『在る』があった。」"
      },
      "ko": {
        "text": " “생각이 있기 전에 ‘있음’이 있었다.”"
      },
      "fr": {
        "text": " « Avant qu’il y ait la pensée, il y avait l’être. »"
      },
      "de": {
        "text": " „Bevor es Gedanken gab, gab es das Sein.“"
      },
      "es": {
        "text": " «Antes de que hubiera pensamiento, estaba el ser»."
      },
      "pt": {
        "text": " “Antes de haver pensamento, havia o ser.”"
      },
      "ar": {
        "text": " «وقبل أن يكون هناك فكر، كان هناك الوجود.»"
      },
      "hi": {
        "text": " “विचार होने से पहले, ‘होना’ था।”"
      }
    }
  },
  "pages.scopes-of-god.body.ul001.li001.p001.strong001.text001": {
    "strings": {
      "en": {
        "text": "This is the undivided isness."
      },
      "zh": {
        "text": "这就是不可分割的“存在本身”。"
      },
      "ja": {
        "text": "これが、分かつことのできない「在ることそのもの」です。"
      },
      "ko": {
        "text": "이것이 나뉘지 않은 ‘존재 그 자체’입니다."
      },
      "fr": {
        "text": "C’est l’être indivisible en soi."
      },
      "de": {
        "text": "Das ist das ungeteilte Sein an sich."
      },
      "es": {
        "text": "Esto es el ser indiviso en sí."
      },
      "pt": {
        "text": "Isto é o ser indiviso em si."
      },
      "ar": {
        "text": "هذا هو الوجود غير المنقسم في ذاته."
      },
      "hi": {
        "text": "यही अविभाजित ‘होना’ है।"
      }
    }
  },
