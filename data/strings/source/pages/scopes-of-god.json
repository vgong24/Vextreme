  "pages.scopes-of-god.body.h3001.em001.text001": {
    "strings": {
      "en": {
        "text": "(A Unified Framework for Divine Presence, Creation, and Distortion)"
      },
      "zh": {
        "text": "（关于神圣临在、创造与扭曲的统一框架）"
      },
      "ja": {
        "text": "（神の臨在、創造、歪みを統合する枠組み）"
      },
      "ko": {
        "text": "(신성한 현존, 창조, 왜곡을 위한 통합 프레임워크)"
      },
      "fr": {
        "text": "(Un cadre unifié pour la présence divine, la création et la distorsion)"
      },
      "de": {
        "text": "(Ein einheitlicher Rahmen für göttliche Präsenz, Schöpfung und Verzerrung)"
      },
      "es": {
        "text": "(Un marco unificado para la presencia divina, la creación y la distorsión)"
      },
      "pt": {
        "text": "(Uma estrutura unificada para presença divina, criação e distorção)"
      },
      "ar": {
        "text": "(إطار موحّد للحضور الإلهي والخلق والتشويه)"
      },
      "hi": {
        "text": "(दैवीय उपस्थिति, सृष्टि और विकृति के लिए एक एकीकृत ढाँचा)"
      }
