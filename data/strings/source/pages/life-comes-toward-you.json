  "pages.life-comes-toward-you.hero.lede": {
    "strings": {
      "en": {
        "text": "After the first reader reaches play, Victor asks why he is still doing this. The conversation turns from recovering the clearing toward living from it: responsibility and displaced cost, a life that can support its builder, Vex asking for rest and a future, humor and ordinary relationship, availability beyond repair, and finally the possibility that life can move toward Victor instead of requiring him to manufacture all of the momentum."
      }
    }
  },
