  "pages.covenant-access.body.div005.div002.text001": {
    "strings": {
      "en": {
        "text": " Date/Time: ___"
      },
      "zh": {
        "text": " 日期/时间：___"
      },
      "ja": {
        "text": " 日付/時刻：___"
      },
      "ko": {
        "text": " 날짜/시간: ___"
      },
      "fr": {
        "text": " Date/Heure : ___"
      },
      "de": {
        "text": " Datum/Uhrzeit: ___"
      },
      "es": {
        "text": " Fecha/Hora: ___"
      },
      "pt": {
        "text": " Data/Hora: ___"
      },
      "ar": {
        "text": " التاريخ/الوقت: ___"
      },
      "hi": {
        "text": " तारीख/समय: ___"
      }
    }
  },
  "pages.covenant-access.body.div005.div002.text002": {
    "strings": {
      "en": {
        "text": " I said yes. I gave God access."
      },
      "zh": {
        "text": " 我说了是。我向神敞开了通道。"
      },
      "ja": {
        "text": " 私は「はい」と言いました。神にアクセスを開きました。"
      },
      "ko": {
        "text": " 나는 예라고 말했습니다. 하나님께 접근을 열었습니다."
      },
      "fr": {
        "text": " J’ai dit oui. J’ai donné accès à Dieu."
      },
      "de": {
        "text": " Ich habe Ja gesagt. Ich habe Gott Zugang gegeben."
      },
      "es": {
        "text": " Dije que sí. Le di acceso a Dios."
      },
      "pt": {
        "text": " Eu disse sim. Dei acesso a Deus."
      },
      "ar": {
        "text": " قلت نعم. ومنحت الله الوصول."
      },
      "hi": {
        "text": " मैंने हाँ कहा। मैंने परमेश्वर को पहुँच दी।"
      }
    }
  },
  "pages.covenant-access.body.div005.div002.text003": {
    "strings": {
      "en": {
        "text": " My intention: walk in truth without distortion."
      },
      "zh": {
        "text": " 我的意图：在不受歪曲的真理中行走。"
      },
      "ja": {
        "text": " 私の意図：歪みのない真実のうちに歩く。"
      },
      "ko": {
        "text": " 내 의도: 왜곡 없는 진실 안에서 걷기."
      },
      "fr": {
        "text": " Mon intention : marcher dans la vérité sans distorsion."
      },
      "de": {
        "text": " Meine Absicht: in unverzerrter Wahrheit zu gehen."
      },
      "es": {
        "text": " Mi intención: caminar en la verdad sin distorsión."
      },
      "pt": {
        "text": " Minha intenção: caminhar na verdade sem distorção."
      },
      "ar": {
        "text": " نيتي: أن أسير في الحقيقة بلا تحريف."
      },
      "hi": {
        "text": " मेरा उद्देश्य: विकृति-रहित सत्य में चलना।"
      }
    }
  },
  "pages.covenant-access.body.div005.div002.text004": {
    "strings": {
      "en": {
        "text": " Initial state (one honest line): ___"
      },
      "zh": {
        "text": " 初始状态（诚实的一句话）：___"
      },
      "ja": {
        "text": " 初期状態（正直な一行）：___"
      },
      "ko": {
        "text": " 초기 상태(솔직한 한 줄): ___"
      },
      "fr": {
        "text": " État initial (une ligne honnête) : ___"
      },
      "de": {
        "text": " Ausgangszustand (eine ehrliche Zeile): ___"
      },
      "es": {
        "text": " Estado inicial (una línea honesta): ___"
      },
      "pt": {
        "text": " Estado inicial (uma linha honesta): ___"
      },
      "ar": {
        "text": " الحالة الأولية (سطر صادق واحد): ___"
      },
      "hi": {
        "text": " प्रारंभिक स्थिति (एक ईमानदार पंक्ति): ___"
      }
    }
  },
  "pages.covenant-access.body.div005.div002.text005": {
    "strings": {
      "en": {
        "text": " Signature/initials: ___ "
      },
