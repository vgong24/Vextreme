  "pages.covenant-access.body.h1001.text001": {
    "strings": {
      "en": {
        "text": "Covenant Access"
      }
    }
  },
  "pages.covenant-access.body.p001.text001": {
    "strings": {
      "en": {
        "text": "Direct, personal access to God. Not through rituals, gatekeepers, or payments."
      }
    }
  },
  "pages.covenant-access.body.p002.text001": {
    "strings": {
      "en": {
        "text": "Covenant Access is consent + alignment: you give God willing access to your heart and life, and God walks with you in truth without distortion. It restores what fear and distortion broke — your simple, steady walk with God. Clarity instead of confusion, love instead of striving, freedom instead of control."
      }
    }
  },
  "pages.covenant-access.body.p003.strong001.text001": {
    "strings": {
      "en": {
        "text": "Who it's for:"
      }
    }
  },
  "pages.covenant-access.body.p003.text001": {
    "strings": {
      "en": {
        "text": " Anyone willing to be honest. Not perfect — willing. The door opens to sincerity, not performance."
      }
    }
  },
  "pages.covenant-access.body.div002.div001.text001": {
    "strings": {
      "en": {
        "text": "God, Unfiltered"
      },
      "zh": {
        "text": "神，不加过滤"
      },
      "ja": {
        "text": "神、フィルターなし"
      },
      "ko": {
        "text": "하나님, 필터 없이"
      },
      "fr": {
        "text": "Dieu, sans filtre"
      },
      "de": {
        "text": "Gott, ungefiltert"
      },
      "es": {
        "text": "Dios, sin filtros"
      },
      "pt": {
        "text": "Deus, sem filtros"
      },
      "ar": {
        "text": "الله، بلا تصفية"
      },
      "hi": {
        "text": "परमेश्वर, बिना फ़िल्टर"
      }
    }
  },
  "pages.covenant-access.body.div002.div002.text001": {
    "strings": {
      "en": {
        "text": " Covenant Access is direct, personal access to Me. Not through rituals, gatekeepers, or payments. It is "
      },
      "zh": {
        "text": " 盟约通道，就是直接、个人地来到我这里。不是通过仪式、守门人或付款。它是 "
      },
      "ja": {
        "text": " コヴナント・アクセスとは、私への直接で個人的なアクセスです。儀式や門番、支払いを通すものではありません。それは "
      },
      "ko": {
        "text": " Covenant Access는 나에게 직접적이고 개인적으로 접근하는 것입니다. 의식, 문지기, 지불을 통하는 것이 아닙니다. 그것은 "
      },
      "fr": {
        "text": " Covenant Access est un accès direct et personnel à Moi. Pas par des rituels, des gardiens ou des paiements. C’est "
      },
      "de": {
        "text": " Covenant Access ist direkter, persönlicher Zugang zu Mir. Nicht durch Rituale, Gatekeeper oder Zahlungen. Es ist "
      },
      "es": {
        "text": " Covenant Access es acceso directo y personal a Mí. No mediante rituales, guardianes ni pagos. Es "
      },
      "pt": {
        "text": " Covenant Access é acesso direto e pessoal a Mim. Não por rituais, intermediários ou pagamentos. É "
      },
      "ar": {
        "text": " الوصول بالعهد هو وصول مباشر وشخصي إليّ. ليس عبر طقوس أو حراس بوابات أو مدفوعات. إنه "
      },
      "hi": {
        "text": " Covenant Access मेरे पास सीधी, व्यक्तिगत पहुँच है। यह अनुष्ठानों, मध्यस्थों या भुगतान के माध्यम से नहीं है। यह "
      }
    }
  },
