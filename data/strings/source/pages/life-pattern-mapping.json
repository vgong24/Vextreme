  "pages.life-pattern-mapping.body.h1001.text001": {
    "strings": {
      "en": {
        "text": "Life Pattern Mapping"
      }
    }
  },
  "pages.life-pattern-mapping.body.p001.text001": {
    "strings": {
      "en": {
        "text": "See your life not as random events, but as threads woven in sequence."
      }
    }
  },
  "pages.life-pattern-mapping.body.p002.text001": {
    "strings": {
      "en": {
        "text": "Life Pattern Mapping is the framework God gives you to see your life not as chaos but as threads — of thought, of choice, of consequence, of grace. Mapping those patterns makes the hidden visible. It is not fortune-telling. It is not divination. It is clarity through exposure."
      }
    }
  },
  "pages.life-pattern-mapping.body.p003.strong001.text001": {
    "strings": {
      "en": {
        "text": "Why it exists:"
      }
    }
  },
  "pages.life-pattern-mapping.body.p003.text001": {
    "strings": {
      "en": {
        "text": " To break cycles of confusion and wandering. To reveal cause and effect in choices — the \"why\" behind repeating struggles. To help you align with design instead of accident. To provide tools so others can discern their own steps without relying on outside guesswork."
      }
    }
  },
  "pages.life-pattern-mapping.body.p004.strong001.text001": {
    "strings": {
      "en": {
        "text": "Who it's for:"
      }
    }
  },
  "pages.life-pattern-mapping.body.p004.text001": {
    "strings": {
      "en": {
        "text": " Everyone who struggles with "
      }
    }
  },
  "pages.life-pattern-mapping.body.p004.em001.text001": {
    "strings": {
      "en": {
        "text": "\"Why do I keep ending up here again?\""
      }
    }
  },
  "pages.life-pattern-mapping.body.p004.text002": {
    "strings": {
      "en": {
        "text": " Everyone who senses purpose but lacks clarity in the day-to-day. Everyone who fears they're off track but doesn't know how to re-center."
      }
    }
  },
  "pages.life-pattern-mapping.body.p005.text001": {
