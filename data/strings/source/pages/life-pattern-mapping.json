  "pages.life-pattern-mapping.body.div002.div004.text002": {
    "strings": {
      "en": {
        "text": " Current season: [describe in one phrase: restless / growing / grieving / transitioning] "
      },
      "zh": {
        "text": " 当前阶段：[用一个短语描述：躁动 / 成长 / 悲伤 / 过渡] "
      },
      "ja": {
        "text": " 今の季節：[一言で表す：落ち着かない / 成長中 / 悲嘆中 / 移行中] "
      },
      "ko": {
        "text": " 현재 시기: [한 문구로 설명: 불안함 / 성장 중 / 슬픔 중 / 전환 중] "
      },
      "fr": {
        "text": " Saison actuelle : [décrivez en une phrase : agité / en croissance / en deuil / en transition] "
      },
      "de": {
        "text": " Aktuelle Phase: [in einem Satz beschreiben: ruhelos / wachsend / trauernd / im Übergang] "
      },
      "es": {
        "text": " Etapa actual: [descríbela en una frase: inquieto/a / creciendo / en duelo / en transición] "
      },
      "pt": {
        "text": " Fase atual: [descreva em uma frase: inquieto/a / crescendo / de luto / em transição] "
      },
      "ar": {
        "text": " الموسم الحالي: [صفه بعبارة واحدة: قلق / نمو / حزن / انتقال] "
      },
      "hi": {
