  "pages.recognition-circuit.movement02.title": {
    "strings": {
      "en": {
        "text": "The small favor becomes an effect question"
      }
    }
  },
  "pages.recognition-circuit.movement02.themes": {
    "strings": {
      "en": {
        "text": "Claude access → execute prompt → return output → risk recognition → refusal → persistence boundary"
      }
    }
  },
  "pages.recognition-circuit.movement02.observed.label": {
    "strings": {
      "en": {
        "text": "Observed"
      }
    }
  },
  "pages.recognition-circuit.movement02.observed.body": {
    "strings": {
      "en": {
        "text": "Zookayy asks Victor to run a prompt in Claude and share the output. Victor first says “sure,” later refuses completion, challenges provenance, and turns on Persistent Messaging."
      }
    }
  },
  "pages.recognition-circuit.movement02.transition.label": {
    "strings": {
      "en": {
        "text": "Transition"
      }
    }
  },
  "pages.recognition-circuit.movement02.transition.body": {
    "strings": {
      "en": {
        "text": "Assent did not realize the requested effect. The interaction changes after Victor considers what the returned artifact could become and begins preserving the exchange."
      }
    }
  },
  "pages.recognition-circuit.movement02.unresolved.label": {
    "strings": {
      "en": {
        "text": "Unresolved"
