  "pages.recognition-circuit.movement01.observed.body": {
    "strings": {
      "en": {
        "text": "Victor publicly framed a claimed covert-manipulation playbook, named OpenAI and Anthropic, described guardrail/root-wound claims, and announced a May 30 synthesis target."
      }
    }
  },
